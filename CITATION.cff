license: CC-BY-NC-ND-4.0
url: "https://mtalebi.github.io/Structural-Dynamics-Book/"
repository-code: "https://github.com/MTalebi/Linear-Structural-Dynamics"
keywords:
  - structural dynamics
  - single degree of freedom
  - SDOF
  - OpenSeesPy
  - state space
  - response spectrum
  - earthquake engineering
  - modal analysis
  - NumPy
